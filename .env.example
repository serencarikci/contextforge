CONTEXTFORGE_APP_NAME=contextforge-api
CONTEXTFORGE_APP_ENVIRONMENT=local
CONTEXTFORGE_APP_DEBUG=true
CONTEXTFORGE_APP_VERSION=0.6.0

CONTEXTFORGE_API_HOST=0.0.0.0
CONTEXTFORGE_API_PORT=8000
CONTEXTFORGE_API_ROOT_PATH=
CONTEXTFORGE_API_CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]
CONTEXTFORGE_API_DOCS_ENABLED=true

CONTEXTFORGE_POSTGRES_HOST=localhost
CONTEXTFORGE_POSTGRES_PORT=5432
CONTEXTFORGE_POSTGRES_USER=contextforge
CONTEXTFORGE_POSTGRES_PASSWORD=contextforge_dev_password
CONTEXTFORGE_POSTGRES_DATABASE=contextforge
CONTEXTFORGE_POSTGRES_POOL_SIZE=5
CONTEXTFORGE_POSTGRES_MAX_OVERFLOW=10
CONTEXTFORGE_POSTGRES_ECHO=false

CONTEXTFORGE_REDIS_URL=redis://localhost:6379/0
CONTEXTFORGE_REDIS_TIMEOUT_SECONDS=2.0

CONTEXTFORGE_QDRANT_URL=http://localhost:6333
CONTEXTFORGE_QDRANT_API_KEY=
CONTEXTFORGE_QDRANT_TIMEOUT_SECONDS=3.0
CONTEXTFORGE_QDRANT_COLLECTION_NAME=document_chunks

CONTEXTFORGE_EMBEDDING_PROVIDER=hashing
CONTEXTFORGE_EMBEDDING_MODEL=contextforge-multilingual-hash-v1
CONTEXTFORGE_EMBEDDING_DIMENSIONS=384
CONTEXTFORGE_EMBEDDING_BATCH_SIZE=32
CONTEXTFORGE_EMBEDDING_MAX_RETRIES=3
CONTEXTFORGE_EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
CONTEXTFORGE_EMBEDDING_BASE_URL=https://api.openai.com/v1
CONTEXTFORGE_EMBEDDING_API_KEY=
CONTEXTFORGE_EMBEDDING_TIMEOUT_SECONDS=30.0

CONTEXTFORGE_MINIO_ENDPOINT=localhost:9000
CONTEXTFORGE_MINIO_ACCESS_KEY=contextforge_minio
CONTEXTFORGE_MINIO_SECRET_KEY=contextforge_minio_secret
CONTEXTFORGE_MINIO_BUCKET=contextforge-documents
CONTEXTFORGE_MINIO_SECURE=false
CONTEXTFORGE_MINIO_REGION=us-east-1
CONTEXTFORGE_MINIO_TIMEOUT_SECONDS=3.0

CONTEXTFORGE_INGESTION_ENABLED=true
CONTEXTFORGE_INGESTION_QUEUE_KEY=contextforge:ingestion:jobs
CONTEXTFORGE_INGESTION_MAX_ATTEMPTS=3
CONTEXTFORGE_INGESTION_POLL_TIMEOUT_SECONDS=5.0
CONTEXTFORGE_INGESTION_RETRY_BACKOFF_SECONDS=1.0
CONTEXTFORGE_INGESTION_WORKER_IDLE_SLEEP_SECONDS=0.5

CONTEXTFORGE_RAG_DENSE_WEIGHT=0.6
CONTEXTFORGE_RAG_LEXICAL_WEIGHT=0.4
CONTEXTFORGE_RAG_TOP_K=20
CONTEXTFORGE_RAG_CANDIDATE_MULTIPLIER=3
CONTEXTFORGE_RAG_MAX_CONTEXT_TOKENS=3000
CONTEXTFORGE_RAG_MAX_CHUNKS_IN_CONTEXT=8
CONTEXTFORGE_RAG_DEFAULT_LANGUAGE=en
CONTEXTFORGE_RAG_FUSION_METHOD=weighted
CONTEXTFORGE_RAG_RRF_K=60
CONTEXTFORGE_RAG_LEXICAL_CORPUS_LIMIT=5000

CONTEXTFORGE_RERANK_PROVIDER=hashing
CONTEXTFORGE_RERANK_TOP_N=8
CONTEXTFORGE_RERANK_MODEL=contextforge-hash-reranker-v1
CONTEXTFORGE_RERANK_BASE_URL=https://api.openai.com/v1
CONTEXTFORGE_RERANK_API_KEY=
CONTEXTFORGE_RERANK_TIMEOUT_SECONDS=30.0
CONTEXTFORGE_RERANK_MAX_RETRIES=2
CONTEXTFORGE_RERANK_RETRY_BACKOFF_SECONDS=0.5

CONTEXTFORGE_LLM_PROVIDER=mock
CONTEXTFORGE_LLM_MODEL=gpt-4o-mini
CONTEXTFORGE_LLM_BASE_URL=https://api.openai.com/v1
CONTEXTFORGE_LLM_API_KEY=
CONTEXTFORGE_LLM_AZURE_ENDPOINT=
CONTEXTFORGE_LLM_AZURE_API_VERSION=2024-10-21
CONTEXTFORGE_LLM_AZURE_DEPLOYMENT=
CONTEXTFORGE_LLM_TEMPERATURE=0.2
CONTEXTFORGE_LLM_MAX_OUTPUT_TOKENS=1024
CONTEXTFORGE_LLM_TIMEOUT_SECONDS=60.0
CONTEXTFORGE_LLM_MAX_RETRIES=2
CONTEXTFORGE_LLM_RETRY_BACKOFF_SECONDS=0.5

CONTEXTFORGE_PROMPTS_ACTIVE_VERSION=v1
CONTEXTFORGE_PROMPTS_DEFAULT_LANGUAGE=en

CONTEXTFORGE_CHAT_MAX_MESSAGE_LENGTH=8000
CONTEXTFORGE_CHAT_MAX_PARTICIPANTS=25
CONTEXTFORGE_CHAT_DEFAULT_LANGUAGE=en
CONTEXTFORGE_CHAT_HISTORY_MAX_MESSAGES=20
CONTEXTFORGE_CHAT_MEMORY_STRATEGY=token_budget
CONTEXTFORGE_CHAT_MEMORY_TOKEN_BUDGET=2000
CONTEXTFORGE_CHAT_MEMORY_SUMMARY_TRIGGER_MESSAGES=30
CONTEXTFORGE_CHAT_MEMORY_SUMMARY_RECENT_MESSAGES=6
CONTEXTFORGE_CHAT_SUGGESTION_COUNT=4
CONTEXTFORGE_CHAT_STREAM_HEARTBEAT_SECONDS=15.0
CONTEXTFORGE_CHAT_EXPORT_MAX_MESSAGES=5000

CONTEXTFORGE_ADMIN_RETENTION_ENABLED=true
CONTEXTFORGE_ADMIN_RETENTION_BATCH_SIZE=500
CONTEXTFORGE_ADMIN_RETENTION_DEFAULT_DAYS=365
CONTEXTFORGE_ADMIN_RETENTION_WORKER_INTERVAL_SECONDS=3600.0
CONTEXTFORGE_ADMIN_CACHE_TTL_SECONDS=30
CONTEXTFORGE_ADMIN_TOKEN_USAGE_ROLLUP_ENABLED=true
CONTEXTFORGE_ADMIN_TOKEN_PRICING_CURRENCY=USD
CONTEXTFORGE_ADMIN_LLM_TEST_TIMEOUT_SECONDS=5.0

CONTEXTFORGE_LOGGING_LEVEL=INFO
CONTEXTFORGE_LOGGING_FORMAT=console
CONTEXTFORGE_LOGGING_SERVICE_NAME=contextforge-api

CONTEXTFORGE_SECURITY_SECRET_KEY=change-me-local-only-not-for-production
CONTEXTFORGE_SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=60
CONTEXTFORGE_SECURITY_ALGORITHM=HS256

CONTEXTFORGE_RATE_LIMIT_ENABLED=true
CONTEXTFORGE_RATE_LIMIT_REQUESTS=120
CONTEXTFORGE_RATE_LIMIT_WINDOW_SECONDS=60
CONTEXTFORGE_RATE_LIMIT_BACKEND=memory
CONTEXTFORGE_RATE_LIMIT_REDIS_KEY_PREFIX=contextforge:ratelimit
CONTEXTFORGE_RATE_LIMIT_EXCLUDE_PATH_PREFIXES=/api/v1/health

CONTEXTFORGE_OBSERVABILITY_METRICS_ENABLED=true
CONTEXTFORGE_OBSERVABILITY_METRICS_PATH=/metrics
CONTEXTFORGE_OBSERVABILITY_DEPENDENCY_GAUGE_ENABLED=true

CONTEXTFORGE_SKIP_HEALTHCHECK=false
